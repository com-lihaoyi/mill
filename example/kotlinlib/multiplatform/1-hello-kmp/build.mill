// A minimal Kotlin Multiplatform module `foo`, compiled for the JVM and for
// Kotlin/JS (Node.js). Code shared between platforms lives in `commonMain`,
// and `expect` declarations there are implemented by `actual` declarations in
// `jvmMain` and `jsMain`.

package build
import mill.*, kotlinlib.*, kotlinlib.js.*

// PROTOTYPE: the two traits below are meant to move into `mill.kotlinlib`.

/**
 * A [[KotlinModule]] compiling a chain of Kotlin Multiplatform source sets
 * ("fragments"), laid out as `src/<fragment>/kotlin`. Every fragment refines
 * the next one in [[kmpFragments]], e.g. `jvmMain` refines `commonMain`.
 */
trait KmpFragmentsModule extends KotlinModule {

  /** The folder containing `src/<fragment>/kotlin` */
  def kmpSourcesRoot: os.Path

  /** Fragment names, from the most specific to `common*` */
  def kmpFragments: Seq[String]

  override def sources = Task.Sources(kmpFragments.map(f => kmpSourcesRoot / "src" / f / "kotlin")*)

  def kmpFragmentOptions: T[Seq[String]] = Task {
    val fragmentSources = kmpFragments.zip(sources()).flatMap { case (fragment, root) =>
      if (!os.exists(root.path)) Nil
      else os.walk(root.path).filter(p => os.isFile(p) && p.ext == "kt").map(p => s"$fragment:$p")
    }
    val refines = kmpFragments.zip(kmpFragments.drop(1)).map { case (from, to) => s"$from:$to" }

    Seq(s"-Xfragments=${kmpFragments.mkString(",")}") ++
      Option.when(refines.nonEmpty)(s"-Xfragment-refines=${refines.mkString(",")}") ++
      Option.when(fragmentSources.nonEmpty)(s"-Xfragment-sources=${fragmentSources.mkString(",")}")
  }

  override def kotlincOptions = Task {
    // test modules inherit the fragment options of their outer module
    super.kotlincOptions().filterNot(_.startsWith("-Xfragment")) ++ kmpFragmentOptions()
  }
}

/** A `.jvm`/`.js`/etc. submodule compiling `<platform>Main` together with `commonMain` */
trait KmpPlatformModule extends PlatformKotlinModule, KmpFragmentsModule { kmp =>

  /** Intermediate source sets between the platform and `common`, e.g. `web` for JS */
  def kmpIntermediateSourceSets: Seq[String] = Nil

  def kmpSourceSets: Seq[String] =
    Seq(platformCrossSuffix) ++ kmpIntermediateSourceSets ++ Seq("common")

  def kmpSourcesRoot = moduleDir
  def kmpFragments = kmpSourceSets.map(_ + "Main")

  trait KmpTests extends KotlinTests, KmpFragmentsModule {
    def kmpSourcesRoot = kmp.moduleDir
    def kmpFragments = kmp.kmpSourceSets.map(_ + "Test")
  }
}

object foo extends Module {
  trait FooModule extends KmpPlatformModule {
    def kotlinVersion = "2.2.20"
  }

  object jvm extends FooModule {
    def mainClass = Some("foo.MainKt")

    object test extends KmpTests, TestModule.Junit4 {
      def mvnDeps = Seq(mvn"org.jetbrains.kotlin:kotlin-test-junit:${kotlinVersion()}")
    }
  }

  object js extends FooModule, KotlinJsModule {
    // matches the default hierarchy of the Kotlin Gradle plugin 2.2.20
    def kmpIntermediateSourceSets = Seq("web")
    def kotlinJsModuleKind = ModuleKind.ESModule
    def kotlinJsRunTarget = Some(RunTarget.Node)

    object test extends KmpTests, KotlinTestPackageTests
  }
}

/** Usage

> ./mill foo.jvm.run
Hello from JVM

> ./mill foo.js.run
Hello from JS

> ./mill foo.jvm.test
...foo.GreetingTest...greetingMentionsPlatform...
...foo.JvmPlatformTest...platformIsJvm...

> ./mill foo.js.test
...Tests: 1, Passed: 1, Failed: 0, Skipped: 0...

*/
