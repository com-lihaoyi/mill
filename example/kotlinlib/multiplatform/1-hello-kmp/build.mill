// A minimal Kotlin Multiplatform module `foo`, compiled for the JVM and for
// Kotlin/JS (Node.js). Code shared between platforms lives in `commonMain`,
// and `expect` declarations there are implemented by `actual` declarations in
// `jvmMain` and `jsMain`.

package build
import mill.*, kotlinlib.*, kotlinlib.js.*

// PROTOTYPE: the trait below is meant to move into `mill.kotlinlib`.

/**
 * A Kotlin Multiplatform module, laid out as `src/<sourceSet>/kotlin`
 * (e.g. `src/commonMain/kotlin`, `src/jvmMain/kotlin`), with one
 * [[PlatformModule]] submodule per target platform.
 */
trait KotlinMultiplatformModule extends Module { kmp =>

  def kotlinVersion: T[String]

  /**
   * The whole source folder, so that changes to it are watched while the
   * source sets themselves are computed by tasks
   */
  def kmpSrc = Task.Source("src")

  def kmpSourceSetDir(sourceSet: String): os.Path = moduleDir / "src" / sourceSet / "kotlin"

  /**
   * A submodule compiling the source sets ("fragments") of one platform,
   * e.g. `jvmMain` and `commonMain`, in one compilation. Every fragment
   * refines the next one in [[kmpFragments]].
   */
  trait PlatformModule extends KotlinModule { platform =>

    def kotlinVersion = Task { kmp.kotlinVersion() }

    /** The platform name, used as a source set prefix, e.g. `jvm` for `jvmMain` */
    def kmpPlatform: String = moduleSegments.value
      .collect { case l: mill.api.Segment.Label => l.value }
      .last

    /** Source set suffix of this compilation, e.g. `Main` or `Test` */
    def kmpCompilation: String = "Main"

    /** Intermediate source sets between the platform and `common`, e.g. `web` for JS */
    def kmpIntermediateSourceSets: T[Seq[String]] = Task { Seq.empty[String] }

    /** Fragment names, from the most specific to `common*` */
    def kmpFragments: T[Seq[String]] = Task {
      (Seq(kmpPlatform) ++ kmpIntermediateSourceSets() ++ Seq("common")).map(_ + kmpCompilation)
    }

    override def sources = Task {
      // re-run on any change under the watched `src/` folder
      kmpSrc()
      kmpFragments().map(f => PathRef(kmpSourceSetDir(f)))
    }

    def kmpFragmentOptions: T[Seq[String]] = Task {
      val fragments = kmpFragments()
      // Sources outside of the fragment folders (e.g. generated sources) belong
      // to the most specific fragment, as in the Kotlin Gradle plugin
      val fragmentSources = allKotlinSourceFiles().map(_.path).map { file =>
        val fragment = fragments.find(f => file.startsWith(kmpSourceSetDir(f))).getOrElse(fragments.head)
        s"$fragment:$file"
      }
      val refines = fragments.zip(fragments.drop(1)).map { case (from, to) => s"$from:$to" }

      Seq(s"-Xfragments=${fragments.mkString(",")}") ++
        Option.when(refines.nonEmpty)(s"-Xfragment-refines=${refines.mkString(",")}") ++
        Option.when(fragmentSources.nonEmpty)(s"-Xfragment-sources=${fragmentSources.mkString(",")}")
    }

    override def kotlincOptions = Task {
      // test modules inherit the fragment options of their outer module
      super.kotlincOptions().filterNot(_.startsWith("-Xfragment")) ++ kmpFragmentOptions()
    }

    trait PlatformTests extends KotlinTests, PlatformModule {
      override def kmpPlatform = platform.kmpPlatform
      override def kmpCompilation = "Test"
      override def kmpIntermediateSourceSets = Task { platform.kmpIntermediateSourceSets() }
    }
  }
}

object foo extends KotlinMultiplatformModule {
  def kotlinVersion = "2.2.20"

  object jvm extends PlatformModule {
    def mainClass = Some("foo.MainKt")

    object test extends PlatformTests, TestModule.Junit4 {
      def mvnDeps = Seq(mvn"org.jetbrains.kotlin:kotlin-test-junit:${this.kotlinVersion()}")
    }
  }

  object js extends PlatformModule, KotlinJsModule {
    // matches the default hierarchy of the Kotlin Gradle plugin 2.2.20
    override def kmpIntermediateSourceSets = Task { Seq("web") }
    def kotlinJsModuleKind = ModuleKind.ESModule
    def kotlinJsRunTarget = Some(RunTarget.Node)

    object test extends PlatformTests, KotlinTestPackageTests
  }
}

/** Usage

> ./mill foo.jvm.run
Hello from JVM

> ./mill foo.js.run
Hello from JS

> ./mill foo.jvm.test
...foo.GreetingTest...greetingMentionsPlatform...
...foo.JvmPlatformTest...platformIsJvm...

> ./mill foo.js.test
...Tests: 1, Passed: 1, Failed: 0, Skipped: 0...

*/
