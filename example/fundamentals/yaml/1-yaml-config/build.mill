/** Usage

> mill show configSeq
[
  "A"
]

> mill show configClass
{
  "value": [
    "M"
  ]
}

> mill show configMap
{
  "default": {
    "value": [
      "X"
    ]
  }
}

> mill show foo.configSeq
[
  "B"
]

> mill show foo.configClass
{
  "value": [
    "N"
  ]
}

> mill show foo.configMap
{
  "new": {
    "value": [
      "Y"
    ]
  }
}

> mill show bar.configSeq
[
  "A",
  "B"
]

> mill show bar.configClass
{
  "value": [
    "M",
    "N"
  ]
}

> mill show bar.configMap
{
  "default": {
    "value": [
      "X"
    ]
  }
  "new": {
    "value": [
      "Y"
    ]
  }
}

> mill show baz.forkEnv
{
  "NULL2": "Null"...
  "NULL3": "NULL"...
  "NULL4": "~"...
  "NULL5": "null"...
  "TRUE1": "y"...
  "TRUE2": "Y"...
  "TRUE3": "yes"...
  "TRUE4": "Yes"...
  "TRUE5": "YES"...
  "TRUE6": "true"...
  "TRUE7": "True"...
  "TRUE8": "TRUE"...
  "TRUE9": "on"...
  "TRUE10": "On"...
  "TRUE11": "ON"...
  "FALSE1": "n"...
  "FALSE2": "N"...
  "FALSE3": "no"...
  "FALSE4": "No"...
  "FALSE5": "NO"...
  "FALSE6": "false"...
  "FALSE7": "False"...
  "FALSE8": "FALSE"...
  "FALSE9": "off"...
  "FALSE10": "Off"...
  "FALSE11": "off"...
  "NUM1": "1.200"...
  "NUM2": ".5"...
  "NUM3": "0.5"...
  "NUM4": "2."...
  "NUM5": "1e3"...
  "NUM6": "-2E-2"...
  "NUM7": ".inf"...
  "NUM8": ".Inf"...
  "NUM9": ".INF"...
  "NUM10": "-.INF"...
  "NUM11": "-.nan"...
  "NUM12": "-.Nan"...
  "NUM13": "-.NAN"...
}

*/
