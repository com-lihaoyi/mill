// :api-spotless: {site-url}/api/latest/mill/javalib/spotless
//
// By default, the format specifications are read from the `.spotless-formats.json`
// configuration file. When that is not flexible enough, override the
// link:{api-spotless}/SpotlessModule.html[SpotlessModule]`spotlessFormats` task instead.


package build
import mill.*, javalib.*
import mill.javalib.spotless.*

object `package` extends JavaModule, SpotlessModule {
  def licenseHeader = Task.Source("LICENSE")

  // Override the formats in code, instead of using a `.spotless-formats.json` file.
  override def spotlessFormats: Task[Seq[Format]] = Task {
    val header = licenseHeader()
    Seq(
      // All Java files are to be formatted using `GoogleJavaFormat` and `LicenseHeader` steps.
      Format("glob:**.java")(
        Format.GoogleJavaFormat(version = "1.35.0"),
        Format.LicenseHeader(
          delimiter = "(package|import|public|class|module) ",
          header = Format.ContentOrFile(file = Format.RelPathRef(header)))
      ),
      // All Markdown files are formatted using the `Flexmark` step.
      Format("glob:**.md")(
        Format.Flexmark()
      ),
      // The `resources/app.properties` file is to be formatted using `TrimTrailingWhitespace` step.
      Format("glob:resources/app.properties")(
        Format.TrimTrailingWhitespace()
      )
    )
  }
}

// Use the same commands to check and format as before in the previous example
