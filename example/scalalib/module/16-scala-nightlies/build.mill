//
// Scala nightly versions are published to https://repo.scala-lang.org/artifactory/maven-nightlies.
// To build a module against the latest Scala 3 nightly, mix in the
// {mill-doc-url}/api/latest/mill/scalalib/ScalaNightlyModule.html[`ScalaNightlyModule`] trait.
// It adds the nightly repository to the module's `repositories`, and sets its
// `scalaVersion` to the newest nightly version found there.
//
package build

import mill.*
import mill.api.*
import mill.scalalib.*

object foo extends ScalaNightlyModule {
  override def mvnDeps = Seq(
    mvn"org.scala-lang.modules::scala-xml:2.4.0"
  )
}

// You can restrict the nightly versions to pick from with `scalaNightlyVersionPrefix`,
// for example to get the latest nightly of a given minor version:

object bar extends ScalaNightlyModule {
  override def scalaNightlyVersionPrefix = "3.8"
}

// You can also pin a specific nightly version by overriding `scalaVersion` as usual,
// while keeping the nightly repository added by `ScalaNightlyModule`:

object qux extends ScalaNightlyModule {
  override def scalaVersion = "3.8.0-RC1-bin-20250825-ee2f641-NIGHTLY"
}

// Nightly versions are meant to try out upcoming compiler changes in your project,
// so Mill warns you when it first picks one, and whenever the picked nightly version
// changes, e.g. after a newer nightly gets published.
//
// The available nightlies are listed on every run, but the repository metadata listing
// them is cached by coursier (for 24 hours by default), and only the cached metadata is
// used with `--offline`. The nightly version is only picked again when that list or
// `scalaNightlyVersionPrefix` change.

/** Usage

> ./mill foo.run You
Hello You!

> ./mill show bar.scalaVersion
"3.8...-NIGHTLY"

> ./mill qux.run You
Hello You!

*/
