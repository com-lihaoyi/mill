package build.utils

import mill.*
import mill.javalib.*
import mill.kotlinlib.*
import millbuild.*

object `package` extends ProjectBaseModule {

  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.jetbrains.kotlinx:kotlinx-datetime:0.8.0",
    mvn"org.jetbrains.kotlinx:kotlinx-serialization-json:1.11.0",
    mvn"org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2"
  )

  def kotlincOptions = Seq("-Xjsr305=strict")

  def kotlincPluginMvnDeps = Seq(
    mvn"org.jetbrains.kotlin:kotlin-serialization-compiler-plugin-embeddable:2.4.0"
  )

  object test extends ProjectBaseTests, TestModule.Junit5 {

    def mvnDeps = Seq(mvn"org.jetbrains.kotlin:kotlin-test-junit5:2.4.0")

    def kotlincOptions = Seq("-Xjsr305=strict")

  }

}
